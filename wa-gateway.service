[Unit]
Description=Snort Gateway — WhatsApp Notifier
After=network.target
PartOf=snort-gateway.service
ConditionPathExists=/opt/ids-dashboard/wa-gateway/config.json

[Service]
Type=simple
WorkingDirectory=/opt/ids-dashboard/wa-gateway
ExecStart=/usr/bin/node /opt/ids-dashboard/wa-gateway/server.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
