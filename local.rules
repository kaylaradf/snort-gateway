# $Id: local.rules,v 1.11 2004/07/23 20:15:44 bmc Exp $
# ----------------
# LOCAL RULES
# ----------------
# This file intentionally does not come with signatures.  Put your local
# additions here.

alert icmp any any -> $HOME_NET any (msg: "ICMP PING: Detected"; priority:3; sid:1000099;rev:1;)

# $Id: local.rules,v 1.11 2004/07/23 20:15:44 bmc Exp $
# ----------------
# LOCAL RULES
# ----------------
# This file intentionally does not come with signatures.  Put your local
# additions here.

#HTTP Detect
alert tcp any any -> $HOME_NET 80 (msg:"HTTP GET WP Container"; content:"GET"; http_method; priority:2; classtype:web-application-activity; sid:1000001; rev:2;)
alert tcp any any -> $HOME_NET 80 (msg:"HTTP POST WP Container"; content:"POST"; http_method; priority:2; classtype:web-application-activity; sid:1000002; rev:2;)
alert tcp any any -> $HOME_NET 80 (msg:"HTTP PUT WP Container"; content:"PUT"; http_method; priority:2; classtype:web-application-activity; sid:1000003; rev:2;)
alert tcp any any -> $HOME_NET 80 (msg:"HTTP DELETE WP Container"; content:"DELETE"; http_method; priority:2; classtype:web-application-activity; sid:1000004; rev:2;)

#NMAP SYN, FIN, NULL, XMAS, UDP SCAN
#alert tcp any any -> $HOME_NET any (msg:"Possible Nmap SYN Scan"; flags:S; detection_filter:track by_src, count 100, seconds 5; classtype:attempted-recon; sid:2000001; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"Possible Nmap FIN Scan"; flags:F; detection_filter:track by_src, count 20, seconds 5; classtype:attempted-recon; sid:2000002; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"Possible Nmap NULL Scan"; flags:0; detection_filter:track by_src, count 20, seconds 5; classtype:attempted-recon; sid:2000003; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"Possible Nmap XMAS Scan"; flags:FPU; detection_filter:track by_src, count 20, seconds 5; classtype:attempted-recon; sid:2000004; rev:1;)
alert udp any any -> $HOME_NET any (msg:"Possible Nmap UDP Scan"; detection_filter:track by_src, count 20, seconds 5; classtype:attempted-recon; sid:2000005; rev:1;)

#NMAP -sV (Show Version)
alert tcp any any -> $HOME_NET 80 (msg:"Nmap HTTP Probe HEAD (-sV)"; content:"HEAD /"; http_method; detection_filter:track by_src, count 5, seconds 10; classtype:attempted-recon; sid:2100001; rev:1;)
alert tcp any any -> $HOME_NET 80 (msg:"NMAP HTTP Probe No User Agent (-sV)"; content:!"User-Agent"; http_header; classtype:attempted-recon; sid:2100002; rev:1;)

#NMAP AGGRESSIVE SCAN
alert tcp any any -> $HOME_NET any (msg:"ET SCAN Nmap Aggressive Scan Detected"; flags:S; detection_filter:track by_src, count 10, seconds 10; classtype:attempted-recon; priority:1; sid:2100003; rev:1;)
